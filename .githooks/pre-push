#!/usr/bin/env bash
# Refuse every push to `main`: main changes only through a squash-merged PR.
# Any other branch push runs the gate (`bash scripts/gate.sh`) first, so a
# branch reaches CI only after the same checks pass locally. Tag pushes and
# branch deletions skip the gate.
#
# Only the owner may bypass this hook.

set -eu

RUN_GATE=0

# Push spec on stdin: `<local-ref> <local-sha> <remote-ref> <remote-sha>` per line.
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF _REMOTE_SHA; do
  if [ "$LOCAL_REF" = "refs/heads/main" ] || [ "$REMOTE_REF" = "refs/heads/main" ]; then
    cat >&2 <<EOF
pre-push: refusing to push 'main'; main changes only through a squash-merged PR.

  Push a task branch instead and open a PR:
      git push -u origin <type>/<slug>

  Only the owner may bypass this hook.
EOF
    exit 1
  fi
  # A deletion sends an all-zero local sha.
  case "$REMOTE_REF:$LOCAL_SHA" in
    refs/heads/*:*[!0]*) RUN_GATE=1 ;;
  esac
done

[ "$RUN_GATE" = "1" ] || exit 0

REPO_TOP=$(git rev-parse --show-toplevel)
# Git exports GIT_DIR (and friends) to hooks in linked worktrees. Tests that
# run `git` in temporary repositories would inherit it and rewrite this
# repository's config, refs and index, so drop them before the gate runs.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
cd "$REPO_TOP"
if ! bash scripts/gate.sh; then
  echo "pre-push: gate failed; fix it before pushing. Only the owner may bypass this hook." >&2
  exit 1
fi
